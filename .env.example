PORT=8766
# Photon 2.0 SMS number, imported into Retell via SIP trunking.
PHOTON_PHONE_NUMBER=
RETELL_API_KEY=
# A Retell Custom LLM agent bound to that imported number (both call directions).
RETELL_AGENT_ID=
# At least 32 random characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PHONE_BRIDGE_SECRET=
# HTTPS tunnel/deployment origin, used to build the Custom LLM URL in the setup command.
PUBLIC_BASE_URL=
